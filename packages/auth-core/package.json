{
  "name": "@notils/auth-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The provider-agnostic auth contract. Types only — no runtime dependencies.",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts"
  },
  "scripts": {
