{
  "name": "@notils/transform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared specifier-rewrite + shape helpers used by both create-notils (scaffold time) and @notils/cli (add time).",
  "exports": {
    ".": "./src/index.ts",
    "./specifiers": "./src/specifiers.ts",
    "./packages": "./src/packages.ts",
    "./project-config": "./src/project-config.ts",
    "./process": "./src/process.ts",
    "./filesystem": "./src/filesystem.ts",
    "./selection": "./src/selection.ts",
    "./environments": "./src/environments.ts",
    "./app-content": "./src/app-content.ts"
  },
  "scripts": {
    "check:detection": "bun run scripts/check-detection.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome check . --write",
    "lint:unsafe": "biome check . --write --unsafe",
    "format": "biome format --write .",
    "check:publishable": "bun run scripts/check-publishable.ts"
  },
  "devDependencies": {
    "@notils/config": "workspace:*",
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3"
  }
}
