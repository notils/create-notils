{
  "name": "@notils/auth-better-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Better Auth provider — satisfies AuthContract for the shared auth UI, plus Better Auth's own server-side helpers.",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts",
    "./server": "./src/server.ts",
    "./config": "./src/config.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome check . --write",
    "lint:unsafe": "biome check . --write --unsafe",
    "format": "biome format --write ."
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@notils/auth-core": "workspace:*",
    "better-auth": "^1.7.2"
  },
  "devDependencies": {
    "@notils/config": "workspace:*",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "typescript": "^6.0.3",
    "zod": "^4.5.4"
  }
}
