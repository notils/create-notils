# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files with real values.
#
# `.env.example` is the deliberate exception: it is the committed reference list
# of every variable this project reads, with no real values in it. Everything else
# stays local. Next.js's own default here is a bare `.env*`, which also swallows
# the example file — and in a standalone scaffold this file becomes the project
# root's .gitignore, so that omission left the one env file that SHOULD be tracked
# silently untracked.
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
